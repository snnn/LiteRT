+  // One-way transition after every runtime has been built and the shared
+  // weights cache has been hard-finalized. This is intentionally Gemma4 E2B
+  // specific: only the nominated INT2 buffers and the 96 MiB QC2 head source.
+  // A rebuilt runtime needs the original model reloaded.
+  absl::StatusOr<size_t> ReleasePackedInt2Sources(
+      const std::vector<std::shared_ptr<Buffer>>& buffers) {
+    if (!runtime_) return absl::FailedPreconditionError("Runtime not prepared");
+    std::set<const Buffer*> owners;
+    std::set<const void*> pointers;
+    for (const auto& buffer : buffers) {
+      owners.insert(buffer.get());
+      auto lock = buffer->Lock();
+      if (!lock.data()) return absl::InternalError("INT2 source lock failed");
+      pointers.insert(lock.data());
+    }
+    size_t constant_bytes = 0;
+    for (const auto& buffer : graph_->constant_buffers()) {
+      if (buffer.size() != 96 * 1024 * 1024)
+        return absl::FailedPreconditionError("Unexpected graph constant");
+      pointers.insert(buffer.data());
+      constant_bytes += buffer.capacity();
+    }
+    // Check all consumers before discarding storage. These sources must only
+    // be static QC2 FC kernels; scales and other execution constants stay live.
+    size_t constant_values = 0;
+    for (size_t id = 0; id < runtime_->num_values; ++id) {
+      const auto& value = runtime_->values[id];
+      if (!value.data || !pointers.count(value.data)) continue;
+      if (value.allocation_type != xnn_allocation_type_static ||
+          value.datatype != xnn_datatype_qcint2 ||
+          (value.flags & XNN_VALUE_FLAG_NEEDS_CLEANUP))
+        return absl::FailedPreconditionError("Source is not a borrowed static QC2 kernel");
+      size_t consumers = 0;
+      for (size_t op_id = 0; op_id < runtime_->num_ops; ++op_id) {
+        const auto& op = runtime_->opdata[op_id];
+        for (size_t i = 0; i < op.num_inputs; ++i) if (op.inputs[i] == id) {
+          if (op.type != xnn_node_type_fully_connected || i != 1 ||
+              !op.operator_objects[0])
+            return absl::FailedPreconditionError("Source has a non-FC consumer");
+          ++consumers;
+        }
+        for (size_t i = 0; i < op.num_outputs; ++i) if (op.outputs[i] == id)
+          return absl::FailedPreconditionError("Source is an operator output");
+      }
+      if (consumers == 0)
+        return absl::FailedPreconditionError("Source has no packed consumer");
+      for (const auto& buffer : graph_->constant_buffers())
+        constant_values += value.data == buffer.data();
+    }
+    if (constant_values != graph_->constant_buffers().size())
+      return absl::FailedPreconditionError("Graph constant was not verified");
+    for (size_t id = 0; id < runtime_->num_values; ++id) {
+      auto& value = runtime_->values[id];
+      if (pointers.count(value.data)) value.data = nullptr;
+    }
+    auto* sg = static_cast<XnnpackGraph&>(*graph_).GetSubgraph();
+    for (size_t id = 0; id < sg->num_values; ++id)
+      if (pointers.count(sg->values[id].data)) sg->values[id].data = nullptr;
+    for (auto& value : graph_->mutable_values()) if (owners.count(value.info.buffer.get())) {
+      value.data = LockedBufferSpan<const std::byte>::Empty();
+      value.info.buffer.reset();
+    }
+    auto& keep = graph_->keep_alive_buffers();
+    keep.erase(std::remove_if(keep.begin(), keep.end(),
+        [&](const auto& buffer) { return owners.count(buffer.get()); }), keep.end());
+    graph_->constant_buffers().clear();
+    return constant_bytes;
+  }
